<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>CareConnect – Care Apps for Elderly</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f5f5f0;
      min-height: 100vh;
      color: #1a1a1a;
    }

    header {
      text-align: center;
      padding: 3rem 1rem 1.5rem;
    }

    .logo-wrap {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: #d1f0e4;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.2rem;
    }

    .logo-wrap svg { width: 36px; height: 36px; }

    h1 {
      font-size: 2rem;
      font-weight: 600;
      color: #111;
      letter-spacing: -0.5px;
    }

    .tagline {
      font-size: 1rem;
      color: #666;
      margin-top: 6px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      max-width: 700px;
      margin: 2rem auto;
      padding: 0 1.25rem;
    }

    @media (max-width: 520px) {
      .grid { grid-template-columns: repeat(2, 1fr); }
      h1 { font-size: 1.6rem; }
    }

    .card {
      background: #fff;
      border: 1px solid #e5e3da;
      border-radius: 14px;
      padding: 1.4rem 1rem;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.08);
      border-color: #c5c3ba;
    }

    .icon-wrap {
      width: 54px;
      height: 54px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-title {
      font-size: 12.5px;
      font-weight: 600;
      color: #222;
      text-align: center;
      line-height: 1.5;
    }

    hr {
      border: none;
      border-top: 1px solid #e5e3da;
      max-width: 700px;
      margin: 0.5rem auto 0;
    }

    footer {
      text-align: center;
      padding: 1.5rem 1rem 2.5rem;
      font-size: 13px;
      color: #666;
      line-height: 1.8;
    }

    footer strong { color: #111; font-weight: 600; }
  </style>
</head>
<body>

  <header>
    <div class="logo-wrap">
      <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 4C18 4 9 9 9 18C9 22.97 13.03 27 18 27C22.97 27 27 22.97 27 18C27 9 18 4 18 4Z" fill="#1d9e75"/>
        <path d="M14 18H22M18 14V22" stroke="white" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </div>
    <h1>CareConnect</h1>
    <p class="tagline">Care Connect Apps for Elderly</p>
  </header>

  <div class="grid">

    <a class="card" href="01 - Fall Detection and SOS Alert.html">
      <div class="icon-wrap" style="background:#faece7;">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <circle cx="14" cy="6" r="2.5" fill="#d85a30"/>
          <path d="M14 10L11 17H13V23H15V17H17L14 10Z" fill="#d85a30"/>
          <path d="M7 20L5 24M21 20L23 24" stroke="#d85a30" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="card-title">Fall Detection &amp; SOS Alert</span>
    </a>

    <a class="card" href="02 - Help Nearby.html">
      <div class="icon-wrap" style="background:#e6f1fb;">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <circle cx="14" cy="12" r="3.5" fill="#378add"/>
          <path d="M14 3C9.58 3 6 6.58 6 11C6 16.5 14 25 14 25C14 25 22 16.5 22 11C22 6.58 18.42 3 14 3Z" stroke="#378add" stroke-width="2" fill="none"/>
        </svg>
      </div>
      <span class="card-title">Help Nearby</span>
    </a>

    <a class="card" href="03 - Blood Donor Finder.html">
      <div class="icon-wrap" style="background:#fcebeb;">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <path d="M14 5C14 5 8 11.5 8 15.5C8 18.8 10.7 21.5 14 21.5C17.3 21.5 20 18.8 20 15.5C20 11.5 14 5 14 5Z" fill="#e24b4a"/>
          <path d="M11 16.5C11 18 12.3 19.2 14 19.2" stroke="white" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="card-title">Blood Donor Finder</span>
    </a>

    <a class="card" href="04 - Medicine Reminder and Health Tracker.html">
      <div class="icon-wrap" style="background:#eaf3de;">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <rect x="10" y="4" width="8" height="3.5" rx="1.2" fill="#639922"/>
          <rect x="7" y="6" width="14" height="17" rx="2.5" stroke="#639922" stroke-width="2" fill="none"/>
          <path d="M10.5 13H17.5M10.5 17H15" stroke="#639922" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="card-title">Medicine Reminder &amp; Health Tracker</span>
    </a>

    <a class="card" href="05 - Missing Person Alert.html">
      <div class="icon-wrap" style="background:#faeeda;">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <circle cx="14" cy="10" r="3.5" fill="#ba7517"/>
          <path d="M7 23C7 19.13 10.13 16 14 16C17.87 16 21 19.13 21 23" stroke="#ba7517" stroke-width="2" stroke-linecap="round" fill="none"/>
          <path d="M22 6L24 4M22 4L24 6" stroke="#e24b4a" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </div>
      <span class="card-title">Missing Person Alert</span>
    </a>

    <a class="card" href="06 - Accessibility Locator.html">
      <div class="icon-wrap" style="background:#eeedfe;">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <circle cx="14" cy="14" r="9" stroke="#7f77dd" stroke-width="2" fill="none"/>
          <path d="M14 6V14L18.5 18.5" stroke="#7f77dd" stroke-width="2" stroke-linecap="round"/>
          <circle cx="14" cy="14" r="2" fill="#7f77dd"/>
        </svg>
      </div>
      <span class="card-title">Accessibility Locator</span>
    </a>

  </div>

  <hr>

  <footer>
    <p>Developed by <strong>Maham Mushtaq</strong> and <strong>Hani Burhan</strong></p>
    <p>Students of GGHSS Khanyar</p>
    <p>Under Supervision of <strong>Dr. Mateen Yousuf</strong>, Teacher, GGHSS Khanyar</p>
  </footer>

</body>
</html>
